rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /tires/{tireId} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      // Portal: CTS stack + grade only (catalog import uses Admin SDK).
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cost',
          'mountCost',
          'deliveryCost',
          'otherCost',
          'cts',
          'grade',
        ]);
    }

    match /portal/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /ghostContacts/{phoneId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Creates via Cloud Functions (Admin). Portal: limited field updates.
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      // Portal: notify + poke only. All metrics / status / completion come from Cloud Functions (Admin).
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customerNotifiedAt',
          'firstNotifiedAt',
          'pokeCount',
          'lastPokedAt',
          'notifyToPokeMinutes',
          'totalTouchpoints',
          'fulfillmentScheduledTime',
          'scheduledAt',
        ]);
    }
  }
}
