rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function canManagePeople() {
      return signedIn()
        && exists(userDocPath())
        && get(userDocPath()).data.permissions.people == 'manage';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || canManagePeople());
      allow create, delete: if false;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastLoginAt',
          'lastLoginIp',
          'lastLoginDevice',
          'lastLoginLocation',
          'loginStreak',
          'recentLogins',
          'handshakeSeen',
        ]);
    }

    match /inviteTokens/{tokenId} {
      allow read: if true;
      allow write: if false;
    }

    match /accessLog/{logId} {
      allow read: if signedIn() && canManagePeople();
      allow write: if false;
    }

    match /tires/{tireId} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      // Portal: CTS stack + grade only (catalog import uses Admin SDK).
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cost',
          'mountCost',
          'deliveryCost',
          'otherCost',
          'cts',
          'grade',
        ]);
    }

    match /portal/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /ghostContacts/{phoneId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Creates via Cloud Functions (Admin). Portal: limited field updates.
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      // Portal: notify + poke only. All metrics / status / completion come from Cloud Functions (Admin).
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customerNotifiedAt',
          'firstNotifiedAt',
          'pokeCount',
          'lastPokedAt',
          'notifyToPokeMinutes',
          'totalTouchpoints',
          'fulfillmentScheduledTime',
          'scheduledAt',
        ]);
    }
  }
}
