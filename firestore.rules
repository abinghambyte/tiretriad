rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function canManagePeople() {
      return signedIn()
        && exists(userDocPath())
        && get(userDocPath()).data.permissions.people == 'manage';
    }

    function userData() {
      return get(userDocPath()).data;
    }

    function crmPerm() {
      return signedIn() && exists(userDocPath())
        && userData().keys().hasAll(['permissions'])
        && userData().permissions.keys().hasAll(['crm'])
        ? userData().permissions.crm
        : 'none';
    }

    function crmView() {
      return crmPerm() in ['view', 'edit', 'manage'];
    }

    function crmEdit() {
      return crmPerm() in ['edit', 'manage'];
    }

    function userRole() {
      return signedIn() && exists(userDocPath()) && userData().keys().hasAll(['role'])
        ? userData().role
        : '';
    }

    function mechanicDjJobUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['completionStatus', 'actualTime', 'notes', 'updatedAt', 'completedAt']);
    }

    function crmAccountPipelineDragOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['pipelineStage', 'pipelineSchemaVersion', 'lastContactedAt', 'updatedAt']);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || canManagePeople());
      allow create, delete: if false;
      // Self-service profile fields the client may edit. Identity fields
      // (role, email, permissions, etc.) are omitted intentionally — those
      // transitions only come from the Admin SDK via `people` callables.
      // `presence` is written by the `updatePresence` callable, but is listed
      // here so a direct client merge of `presence.{lastSeenAt,userAgent}`
      // would still be accepted for the authenticated user.
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastLoginAt',
          'lastLoginIp',
          'lastLoginDevice',
          'lastLoginLocation',
          'loginStreak',
          'recentLogins',
          'handshakeSeen',
          'presence',
        ]);

      // Crew availability — day docs keyed YYYY-MM-DD (Denver), blockedSlots array.
      match /availability/{dateId} {
        allow read: if signedIn() && (request.auth.uid == userId || canManagePeople());
        allow create, update, delete: if signedIn()
          && (request.auth.uid == userId || canManagePeople());
      }
    }

    match /inviteTokens/{tokenId} {
      allow read: if true;
      allow write: if false;
    }

    match /accessLog/{logId} {
      allow read: if signedIn() && canManagePeople();
      allow write: if false;
    }

    // Admin-sensitive action audit trail. Written exclusively by Cloud
    // Functions (Admin SDK bypasses rules); client writes denied. Only
    // Overwatch (admin role) can read the trail.
    match /adminAuditLog/{logId} {
      allow read: if signedIn() && userRole() == 'admin';
      allow write: if false;
    }

    // Timed permission elevation reverts — Cloud Functions (Admin) only.
    match /scheduledReverts/{id} {
      allow read, write: if false;
    }

    match /tires/{tireId} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      // Portal: CTS stack + listing tracking (catalog import uses Admin SDK).
      // The `researchQueue`, `marginConfirmed`, and `marginFloor` fields are
      // server-owned (nightly sweep + enqueueToResearch/resolveQueueItem
      // callables via Admin SDK). Clients can read them but never write.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cost',
          'mountCost',
          'deliveryCost',
          'otherCost',
          'cts',
          'grade',
          'platformListings',
        ])
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['researchQueue', 'marginConfirmed', 'marginFloor']);
    }

    match /portal/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /meta/{docId} {
      allow read: if docId == 'creditTracker'
        ? signedIn() && userRole() == 'admin'
        : docId == 'scheduleSettings'
          ? signedIn()
          : signedIn();
      allow write: if docId == 'creditTracker'
        ? signedIn() && userRole() == 'admin'
        : docId == 'scheduleSettings'
          ? signedIn() && canManagePeople()
          : docId == 'reorderQueue'
            ? signedIn()
              && userRole() == 'admin'
              && (
                !exists(/databases/$(database)/documents/meta/$(docId))
                && request.resource.data.keys().hasOnly(['entries', 'updatedAt'])
                || exists(/databases/$(database)/documents/meta/$(docId))
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entries', 'updatedAt'])
              )
            : false;
    }

    match /expenses/{expenseId} {
      allow read: if signedIn() && userRole() == 'admin';
      allow create: if signedIn()
        && userRole() == 'admin'
        && request.resource.data.keys().hasOnly(['amount', 'category', 'note', 'date', 'loggedBy', 'createdAt'])
        && request.resource.data.amount is number
        && request.resource.data.category in ['fuel', 'supplies', 'tools', 'other']
        && request.resource.data.note is string
        && request.resource.data.date is string
        && request.resource.data.loggedBy is string
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if signedIn() && userRole() == 'admin';
    }

    match /ghostContacts/{phoneId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Customer memory — Functions merge on order complete; portal reads + notes/tags;
    // People managers may add stubs, edit display name, or remove a row (orders may still reference phone key).
    match /contacts/{phone} {
      allow read: if signedIn();
      allow delete: if canManagePeople();
      allow create: if canManagePeople()
        && phone.matches('^[0-9]{10,15}$')
        && request.resource.data.keys().hasOnly([
          'name',
          'phoneNumber',
          'orderCount',
          'totalSpend',
          'notes',
          'lastMspn',
          'lastTireLabel',
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.phoneNumber == phone
        && request.resource.data.orderCount == 0
        && request.resource.data.totalSpend == 0
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 20000
        && request.resource.data.lastMspn is string
        && request.resource.data.lastMspn.size() <= 120
        && request.resource.data.lastTireLabel is string
        && request.resource.data.lastTireLabel.size() <= 400;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'notes',
          'tags',
          'repeatCustomerVote',
          'name',
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || canManagePeople())
        && (!request.resource.data.keys().hasAny(['name'])
          || (request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 200));
    }

    // Creates via Cloud Functions (Admin). Portal: limited field updates.
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      // Portal: notify + poke only (keys below). Status transitions, completion, cancellation,
      // and workflow metrics (e.g. saleToAvailableMinutes, kyleConfirmMinutes, availableToScheduledMinutes,
      // djResponseMinutes, scheduledToInTransitMinutes) are written only by Cloud Functions via the
      // Admin SDK, which bypasses these rules — they must not be added here or any client could forge them.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customerNotifiedAt',
          'firstNotifiedAt',
          'pokeCount',
          'lastPokedAt',
          'pokedAt',
          'notifyToPokeMinutes',
          'totalTouchpoints',
          'fulfillmentScheduledTime',
          'scheduledAt',
          'debrief',
        ]);
    }

    match /crmAccounts/{accountId} {
      allow read: if crmView();
      allow create, delete: if crmEdit();
      allow update: if crmEdit() || (crmView() && crmAccountPipelineDragOnly());
    }

    match /crmLeads/{leadId} {
      allow read: if crmView();
      allow create, delete: if crmEdit();
      allow update: if crmEdit();
    }

    match /crmJobs/{jobId} {
      allow read: if crmView();
      allow create, delete: if crmEdit();
      allow update: if crmEdit() || (userRole() == 'mechanic' && mechanicDjJobUpdateOnly());
    }

    match /crmVehicles/{vehicleId} {
      allow read: if crmView();
      allow create, delete: if crmEdit();
      allow update: if crmEdit();
    }

    match /crmInventory/{rowId} {
      allow read: if crmView();
      allow create, delete: if crmEdit();
      allow update: if crmEdit();
    }

    // Mechanic onboarding — written only via Cloud Function (Admin SDK).
    match /mechanicProfiles/{profileId} {
      allow read, write: if false;
    }
  }
}
