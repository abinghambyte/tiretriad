# Vite — optional overrides; empty values fall back to defaults in src/firebase/config.js
# Use VITE_* only; never put webhook secrets here (they belong on Cloud Functions).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FUNCTIONS_REGION=us-central1

# Sinch Chat widget (SinchChatMount). Both are public client-side values.
# Find in Sinch dashboard -> Chat -> your app. Leave unset to skip the widget.
VITE_SINCH_CHAT_CLIENT_ID=
VITE_SINCH_CHAT_PROJECT_ID=
# Optional: 'US' (default) or 'EU'
VITE_SINCH_CHAT_REGION=
# Optional override for the lead-capture Cloud Function URL.
# Defaults to https://us-central1-<projectId>.cloudfunctions.net/createSinchChatLead
VITE_SINCH_CHAT_LEAD_URL=

# Sentry production error tracking. Set in Vercel project env vars.
VITE_SENTRY_DSN=

# Release SHA for Sentry source-map mapping. Set to ${VERCEL_GIT_COMMIT_SHA} in Vercel.
VITE_RELEASE_SHA=
