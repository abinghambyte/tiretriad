# Gen2: copy to `functions/.env`, fill values, then: npm run deploy:functions
# See docs/FIREBASE-GEN2-SENDTIRESALE-ENV.md

# --- Phase 2 (Slack Block Kit + Interactivity) — preferred when set ---
# Slack app: OAuth scopes chat:write, chat:write.public; invite the bot to #fleet-ops
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
# Public channel ID (C…) is most reliable; #fleet-ops works if the bot is a member
SLACK_CHANNEL_ID=
# Optional alias for channel if SLACK_CHANNEL_ID unset:
# SLACK_NOTIFY_CHANNEL=#fleet-ops

# Completion summary link in Slack (optional; defaults to production portal)
# PORTAL_BASE_URL=https://www.skedaddleinc.com

# --- Legacy / fallback: incoming webhook (used only if SLACK_BOT_TOKEN is unset) ---
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL_2=
NOTIFY_WEBHOOK_STYLE=slack
