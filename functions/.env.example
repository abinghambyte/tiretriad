# Gen2: copy to `functions/.env`, fill values, then: npm run deploy:functions
# See docs/FIREBASE-GEN2-SENDTIRESALE-ENV.md

# --- Phase 2 (Slack Block Kit + Interactivity) — Secret Manager (required for prod) ---
# Create secrets (do not put the same names in this file — deploy will fail with "overlaps"):
#   firebase functions:secrets:set SLACK_BOT_TOKEN
#   firebase functions:secrets:set SLACK_SIGNING_SECRET
#   firebase functions:secrets:set SLACK_CHANNEL_ID
# Emulator: use .secret.local or `firebase functions:secrets:access` patterns per Firebase docs.
# Slash commands (credit, finance, lookups) use the same Request URL as Interactivity
# (…/slackActions) so the function receives application/x-www-form-urlencoded payloads.
# Optional override for mechanic intake submissions (defaults to SLACK_CHANNEL_ID / #fleet-ops)
# SLACK_MECHANIC_INTAKE_CHANNEL=C0123456789
# Optional alias for channel if SLACK_CHANNEL_ID unset:
# SLACK_NOTIFY_CHANNEL=#fleet-ops
# Anthropic — `/hype`, invite greetings, listing advisor fallback (not a Slack credential). Prod: Secret Manager:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
# Do not also set ANTHROPIC_API_KEY in this file for deployed functions that bind that secret (overlap error).
# For local emulator only, you may set ANTHROPIC_API_KEY here if secrets are not wired.
# ANTHROPIC_API_KEY=
# Listing advisor — Gemini (Secret Manager). Use `-` to skip Gemini.
#   firebase functions:secrets:set GEMINI_API_KEY
# Comma/space-separated Slack user IDs for admin-only slash (/setlimit, /setquota):
# SLACK_ADMIN_USER_IDS=U0123456789,U0987654321
# Shareable workspace invite (standard Slack; not admin.users.invite). Returned from completeInviteRegistration.
# SLACK_INVITE_URL=https://join.slack.com/t/your-workspace/shared_invite/...
# Optional — DJ Firebase Auth uid for /schedule, /block, etc. Prefer `meta/scheduleSettings.djUserId` in Firestore.
# DJ_SCHEDULE_UID=

# Completion summary link in Slack (optional; defaults to production portal)
# PORTAL_BASE_URL=https://www.skedaddleinc.com

# --- VIP concierge magic links (callable signing) — Secret Manager (required for prod) ---
#   firebase functions:secrets:set VIP_TOKEN_SECRET
# Do not also set VIP_TOKEN_SECRET in this file for deployed functions that bind that secret (overlap error).
# VIP_TOKEN_SECRET=

# --- Phase 4 (People System) ---
# Comma-separated emails that always receive admin on first profile sync (recommended for prod).
# If unset, the first Firestore `users` doc created becomes admin (small-team bootstrap only).
# BOOTSTRAP_ADMIN_EMAILS=you@company.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Skedaddle <noreply@yourdomain.com>
# (ANTHROPIC_API_KEY — see Phase 2 section above; avoid duplicating with Secret Manager.)
# Optional model override for invite greetings:
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- SMS (Sinch) — optional; used where Sinch is wired ---
# SINCH_SERVICE_PLAN_ID=
# SINCH_API_TOKEN=
# SINCH_FROM_NUMBER=
# Optional shared secret for inboundSms HTTP — send header Authorization: Bearer <value>
# SINCH_INBOUND_SHARED_SECRET=

# --- Legacy / fallback: incoming webhook (used only if SLACK_BOT_TOKEN is unset) ---
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL_2=
NOTIFY_WEBHOOK_STYLE=slack
