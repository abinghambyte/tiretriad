rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function userData() {
      return firestore.get(userDocPath()).data;
    }

    function tirePerm() {
      return signedIn()
        && firestore.exists(userDocPath())
        && userData().keys().hasAll(['permissions'])
        && userData().permissions.keys().hasAll(['tires'])
        ? userData().permissions.tires
        : 'none';
    }

    function tireEdit() {
      return tirePerm() in ['edit', 'manage'];
    }

    match /tires/{mspn}/{fileName} {
      allow read: if signedIn();
      allow create, update: if tireEdit()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if tireEdit();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
